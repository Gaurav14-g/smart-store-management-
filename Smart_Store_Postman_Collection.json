              "raw": "{\n  \"customer\": \"customer-uuid\",\n  \"items\": [\n    {\n      \"product\": \"product-uuid-1\",\n      \"quantity\": 2\n    },\n    {\n      \"product\": \"product-uuid-2\",\n      \"quantity\": 1\n    }\n  ]\n}",
